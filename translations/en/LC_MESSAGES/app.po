# English translation for the Slint C++ template.
#
# The strings in the .slint files are already written in English, so every entry
# below repeats its source text. Keeping them explicit has two advantages: the
# English wording can be changed without touching the UI code, and translators
# of other languages get a complete file to copy.
#
# The directory that contains LC_MESSAGES is the locale, "en" here; the file
# name is the translation domain set in CMakeLists.txt ("app").
#
# Slint uses the name of the enclosing component or global as the default
# translation context, so every entry below needs a msgctxt. Without it the
# string is silently left untranslated. Set the
# SLINT_NO_DEFAULT_TRANSLATION_CONTEXT target property in CMakeLists.txt to drop
# contexts altogether.
msgid ""
msgstr ""
"Project-Id-Version: my_application\n"
"Report-Msgid-Bugs-To: \n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

