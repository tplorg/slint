// The Home page: the counter example that demonstrates the C++/Slint contract.

import { ScrollView, GroupBox, Button } from "std-widgets.slint";
import { PageHeader } from "../components/common.slint";

export component HomePage inherits ScrollView {
    // Forwarded from the window, so that the C++ side keeps its counter API.
    in-out property <int> counter: 42;
    callback request-increase-value();

    VerticalLayout {
        alignment: start;
        padding: 16px;
        spacing: 20px;

        PageHeader {
            title: @tr("Home");
            subtitle: @tr("Every page is a component; the navigation switches between them.");
            has-subtitle: true;
        }

        // The group box is the platform style's own framing of a section.
        GroupBox {
            title: @tr("Counter");

            VerticalLayout {
                alignment: start;
                spacing: 14px;

                Text {
                    text: "\{root.counter}";
                    font-size: 2.5rem;
                    font-weight: 700;
                }

                HorizontalLayout {
                    alignment: start;

                    Button {
                        text: @tr("Increase value");
                        clicked => { root.request-increase-value(); }
                    }
                }
            }
        }
    }
}
